function Get-EndOfLifeHttpStatusCode {
  # Extracts the HTTP status code from an Invoke-RestMethod error, if present.
  param (
    [Parameter(Mandatory)]
    [System.Management.Automation.ErrorRecord] $ErrorRecord
  )

  $response = $ErrorRecord.Exception.Response
  if (-not $response) {
    return $null
  }

  try {
    return [int]$response.StatusCode
  }
  catch {
    return $null
  }
}

function Test-EndOfLifeDateIsActive {
  [CmdletBinding()]
  param (
    [AllowNull()]
    [object] $Value,

    [Parameter(Mandatory)]
    [datetime] $CurrentDate
  )

  if ($null -eq $Value) {
    return $true
  }

  if ($Value -is [bool]) {
    return -not $Value
  }

  $text = ([string]$Value).Trim()
  if ([string]::IsNullOrEmpty($text) -or $text -ieq 'false') {
    return $true
  }

  $date = [datetime]::MinValue
  if ([datetime]::TryParse($text, [ref]$date)) {
    return $date.Date -gt $CurrentDate.Date
  }

  return $false
}

function Test-EndOfLifeLtsValue {
  [CmdletBinding()]
  param (
    [AllowNull()]
    [object] $Value
  )

  if ($null -eq $Value) {
    return $false
  }

  if ($Value -is [bool]) {
    return $Value
  }

  $text = ([string]$Value).Trim()
  -not [string]::IsNullOrEmpty($text) -and $text -ine 'false'
}

function ConvertTo-EndOfLifeNullableString {
  [CmdletBinding()]
  param (
    [AllowNull()]
    [object] $Value
  )

  if ($null -eq $Value) {
    return $null
  }

  if ($Value -is [bool] -and -not $Value) {
    return $null
  }

  $text = ([string]$Value).Trim()
  if ([string]::IsNullOrEmpty($text) -or $text -ieq 'false') {
    return $null
  }

  $text
}


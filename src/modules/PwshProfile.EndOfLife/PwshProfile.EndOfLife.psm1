    [Parameter(ParameterSetName = 'ListProducts')]
    [string] $Like,

    [Parameter(ParameterSetName = 'Query')]
    [switch] $ActiveSupport,

    [Parameter(ParameterSetName = 'Query')]
    [switch] $LtsSupport,

    [ValidateRange(1, 60)]
    [int] $TimeoutSec = 10,

    [uri] $ApiBaseUri = 'https://endoflife.date/api'
  )

  process {
    if ($ListProducts) {
      # Use the generated ValidateSet for both listing and parameter validation.
      $products = @(
        $MyInvocation.MyCommand.Parameters['ProductName'].Attributes |
          Where-Object { $_ -is [System.Management.Automation.ValidateSetAttribute] } |
          ForEach-Object { $_.ValidValues }
      )

      if ([string]::IsNullOrWhiteSpace($Like)) {
        return $products | Sort-Object
      }
      else {
        return $products | Where-Object { $_ -like $Like } | Sort-Object
      }
    }

    $baseUri = ([string]$ApiBaseUri).TrimEnd('/')
    $requestUri = '{0}/{1}.json' -f $baseUri, [System.Uri]::EscapeDataString($ProductName)

    try {
      $entries = Invoke-RestMethod `
        -Uri $requestUri `
        -Headers @{ 'User-Agent' = 'pwsh-profile-endoflife' } `
        -TimeoutSec $TimeoutSec `
        -ErrorAction Stop
    }
    catch {
      if ((Get-EndOfLifeHttpStatusCode -ErrorRecord $_) -eq 429) {
        throw "endoflife.date rate-limited this request (HTTP 429). Wait a minute before trying again."
      }
      throw "Unable to retrieve end-of-life information for '$ProductName'. $($_.Exception.Message)"
    }

    $currentDate = Get-Date
    $results = foreach ($entry in @($entries)) {
      $isLts = Test-EndOfLifeLtsValue -Value $entry.lts
      $isSupported = Test-EndOfLifeDateIsActive -Value $entry.eol -CurrentDate $currentDate

      if ($LtsSupport -and -not $isLts) {
        continue
      }
      if ($ActiveSupport -and -not $isSupported) {
        continue
      }

      [pscustomobject][ordered]@{
        PSTypeName = 'PwshProfile.EndOfLife.Result'
        Product = $ProductName
        Cycle = [string]$entry.cycle
        Latest = [string]$entry.latest
        ReleaseDate = ConvertTo-EndOfLifeNullableString -Value $entry.releaseDate
        LatestReleaseDate = ConvertTo-EndOfLifeNullableString -Value $entry.latestReleaseDate
        Lts = ConvertTo-EndOfLifeNullableString -Value $entry.lts
        Support = ConvertTo-EndOfLifeNullableString -Value $entry.support
        Eol = ConvertTo-EndOfLifeNullableString -Value $entry.eol
        IsSupported = $isSupported
        Link = ConvertTo-EndOfLifeNullableString -Value $entry.link
      }
    }

    $results | Sort-Object {
      $releaseDate = [datetime]::MinValue
      if ([datetime]::TryParse([string]$_.ReleaseDate, [ref]$releaseDate)) {
        $releaseDate
      }
      else {
        [datetime]::MinValue
      }
    } -Descending
  }

<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>PwshProfile.TlsCertificate.Result</Name>
      <ViewSelectedBy>
        <TypeName>PwshProfile.TlsCertificate.Result</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>Source</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Subject</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>NotAfter</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>DaysRemaining</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>IsExpired</Label>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <PropertyName>Source</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Subject</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>NotAfter</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>DaysRemaining</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>IsExpired</PropertyName>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>PwshProfile.TlsCertificate.ChainLink</Name>
      <ViewSelectedBy>
        <TypeName>PwshProfile.TlsCertificate.ChainLink</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>Position</Label>
            <Width>8</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Subject</Label>
            <Width>28</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Issuer</Label>
            <Width>28</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>NotAfter</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>DaysRemaining</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>IsRoot</Label>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <PropertyName>Position</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>SubjectCommonName</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>IssuerCommonName</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>NotAfter</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>DaysRemaining</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>IsRoot</PropertyName>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>PwshProfile.TlsCertificate.PfxSplitResult</Name>
      <ViewSelectedBy>
        <TypeName>PwshProfile.TlsCertificate.PfxSplitResult</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>Source</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>PrivateKeyPath</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>CertificatePath</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>ChainPath</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>PrivateKeyEncrypted</Label>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <PropertyName>Source</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>PrivateKeyPath</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>CertificatePath</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>ChainPath</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>PrivateKeyEncrypted</PropertyName>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>PwshProfile.TlsCertificate.SelfSignedResult</Name>
      <ViewSelectedBy>
        <TypeName>PwshProfile.TlsCertificate.SelfSignedResult</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>CertificatePath</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Subject</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>NotAfter</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>DaysRemaining</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>KeyEncrypted</Label>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <PropertyName>CertificatePath</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Subject</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>NotAfter</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>DaysRemaining</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>KeyEncrypted</PropertyName>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
